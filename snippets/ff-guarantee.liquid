{%- comment -%}
  Guarantee box below the buy form in ff-main-product: an icon (defaults to
  a shield) beside a small heading, heading and text.

  Accepts:
  - block: {Object} the section's guarantee block, which sets the look
  - guarantee: {Object} the product's pdp.guarantee metaobject entry, which
    holds the eyebrow, title, text, link and icon_url
{%- endcomment -%}

{%- liquid
  # Every look setting becomes a CSS variable on the guarantee box
  assign bs = block.settings
  capture guarantee_style
    echo '--guar-border-w: ' | append: bs.border_width | append: 'px;'
    echo '--guar-border-style: ' | append: bs.border_style | append: ';'
    echo '--guar-radius: ' | append: bs.radius | append: 'px;'
    echo '--guar-px: ' | append: bs.padding_x | append: 'px;'
    echo '--guar-py: ' | append: bs.padding_y | append: 'px;'
    echo '--guar-gap: ' | append: bs.icon_gap | append: 'px;'
    echo '--guar-icon: ' | append: bs.icon_size | append: 'px;'
    echo '--guar-icon-m: ' | append: bs.icon_size_mobile | append: 'px;'
    echo '--guar-eyebrow-fs: ' | append: bs.eyebrow_size | append: 'px;'
    echo '--guar-eyebrow-fs-m: ' | append: bs.eyebrow_size_mobile | append: 'px;'
    echo '--guar-title-fs: ' | append: bs.title_size | append: 'px;'
    echo '--guar-title-fs-m: ' | append: bs.title_size_mobile | append: 'px;'
    echo '--guar-text-fs: ' | append: bs.text_size | append: 'px;'
    echo '--guar-text-fs-m: ' | append: bs.text_size_mobile | append: 'px;'
    if bs.background != blank and bs.background.alpha != 0.0
      echo '--guar-bg: ' | append: bs.background | append: ';'
    endif
    if bs.border_color != blank and bs.border_color.alpha != 0.0
      echo '--guar-border-c: ' | append: bs.border_color | append: ';'
    endif
    if bs.eyebrow_color != blank and bs.eyebrow_color.alpha != 0.0
      echo '--guar-eyebrow-c: ' | append: bs.eyebrow_color | append: ';'
    endif
    if bs.title_color != blank and bs.title_color.alpha != 0.0
      echo '--guar-title-c: ' | append: bs.title_color | append: ';'
    endif
    if bs.text_color != blank and bs.text_color.alpha != 0.0
      echo '--guar-text-c: ' | append: bs.text_color | append: ';'
    endif
  endcapture
  assign link = guarantee.link.value
  assign icon_url = guarantee.icon_url.value
-%}

<div
  class="guarantee guarantee--align-{{ bs.align }}{% if bs.title_uppercase %} guarantee--upper{% endif %}"
  style="{{ guarantee_style | strip_newlines }}"
  {{ block.shopify_attributes }}
>
  {%- if link != blank -%}<a class="guarantee__inner" href="{{ link }}">{%- else -%}<div class="guarantee__inner">{%- endif -%}
    {%- if bs.show_icon -%}
      {%- if icon_url != blank -%}
        <img class="guarantee__icon" src="{{ icon_url | escape }}" width="{{ bs.icon_size }}" height="{{ bs.icon_size }}" loading="lazy" alt="">
      {%- else -%}
        <img class="guarantee__icon" src="{{ 'ff-icon-shield.svg' | asset_url }}" width="{{ bs.icon_size }}" height="{{ bs.icon_size }}" loading="lazy" alt="">
      {%- endif -%}
    {%- endif -%}
    <div class="guarantee__body">
      {%- if guarantee.eyebrow.value != blank -%}<p class="guarantee__eyebrow">{{ guarantee.eyebrow.value | escape }}</p>{%- endif -%}
      {%- if guarantee.title.value != blank -%}<p class="guarantee__title">{{ guarantee.title.value | escape }}</p>{%- endif -%}
      {%- if guarantee.text.value != blank -%}<div class="guarantee__text">{{ guarantee.text | metafield_tag }}</div>{%- endif -%}
    </div>
  {%- if link != blank -%}</a>{%- else -%}</div>{%- endif -%}
</div>
