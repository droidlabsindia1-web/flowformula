{%- comment -%}
  Shared assets for the lml-* PDP sections. Safe to render from several
  sections on one page: lml-pdp.js guards against double init.

  Accepts:
  - swiper: {Boolean} load Swiper (gallery / carousels)
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet">
{%- if swiper -%}
  {{ 'lml-swiper.min.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'lml-swiper.min.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{{ 'lml-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lml-pdp.js' | asset_url }}" defer="defer"></script>
