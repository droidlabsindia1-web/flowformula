{%- comment -%}
  Soft gradient artwork for the about page sections, drawn in SVG so it
  stays sharp, takes its colours from CSS variables and animates without a
  library. Each shape is drawn twice: a blurred gradient fill, then a thin
  outline on top.

  Colours come from --art-a (deep), --art-b (light) and --art-line, set on
  a parent element.

  Accepts:
  - art: {String} 'capsules' (story), 'sparkle', 'circles' or 'flower'
  - uid: {String} unique per render, keeps the gradient / filter ids apart
{%- endcomment -%}
{%- liquid
  assign g = 'ffa-grad-' | append: uid
  assign gl = 'ffa-glow-' | append: uid
  assign b = 'ffa-blur-' | append: uid
  assign n = 'ffa-grain-' | append: uid
-%}
{%- case art -%}
  {%- when 'capsules' -%}
    <svg class="ff-art ff-art--capsules" viewBox="0 0 620 620" fill="none" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="{{ gl }}" cx="50%" cy="100%" r="100%">
          <stop offset="0" style="stop-color: var(--art-a)"/>
          <stop offset="1" style="stop-color: var(--art-b)"/>
        </radialGradient>
        <radialGradient id="{{ g }}" cx="62%" cy="58%" r="70%">
          <stop offset="0" style="stop-color: var(--art-a)"/>
          <stop offset="0.55" style="stop-color: var(--art-a); stop-opacity: 0.55"/>
          <stop offset="1" style="stop-color: var(--art-b); stop-opacity: 0.6"/>
        </radialGradient>
        <filter id="{{ b }}" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur stdDeviation="30"/>
        </filter>
        <filter id="{{ n }}" x="0" y="0" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" result="noise"/>
          <feColorMatrix in="noise" type="saturate" values="0" result="mono"/>
          <feComposite in="mono" in2="SourceGraphic" operator="in" result="grain"/>
          <feBlend in="SourceGraphic" in2="grain" mode="soft-light"/>
        </filter>
      </defs>
      <rect class="ff-art__glow" x="60" y="85" width="500" height="450" rx="225" fill="url(#{{ gl }})" filter="url(#{{ b }})"/>
      <g class="ff-art__fill" filter="url(#{{ n }})">
        <rect class="ff-art__pill ff-art__pill--1" x="215" y="120" width="190" height="380" rx="95" fill="url(#{{ g }})"/>
        <rect class="ff-art__pill ff-art__pill--2" x="215" y="120" width="190" height="380" rx="95" fill="url(#{{ g }})" opacity="0.6"/>
      </g>
      <g class="ff-art__lines">
        <rect class="ff-art__pill ff-art__pill--1" x="215" y="120" width="190" height="380" rx="95"/>
        <rect class="ff-art__pill ff-art__pill--2" x="215" y="120" width="190" height="380" rx="95"/>
        <rect class="ff-art__pill ff-art__pill--3" x="215" y="120" width="190" height="380" rx="95"/>
        <rect class="ff-art__pill ff-art__pill--4" x="215" y="120" width="190" height="380" rx="95"/>
      </g>
    </svg>

  {%- when 'sparkle' -%}
    {%- capture shape -%}<path class="ff-art__shape" d="M150 38C157 108 192 143 262 150C192 157 157 192 150 262C143 192 108 157 38 150C108 143 143 108 150 38Z"/>{%- endcapture -%}

  {%- when 'circles' -%}
    {%- capture shape -%}<circle class="ff-art__shape ff-art__shape--main" cx="150" cy="150" r="94"/><circle class="ff-art__shape ff-art__shape--left" cx="112" cy="150" r="64"/><circle class="ff-art__shape ff-art__shape--right" cx="188" cy="150" r="64"/>{%- endcapture -%}

  {%- else -%}
    {%- capture shape -%}<g class="ff-art__shape ff-art__shape--spin"><rect x="122" y="36" width="56" height="228" rx="28"/><rect x="122" y="36" width="56" height="228" rx="28" transform="rotate(45 150 150)"/><rect x="122" y="36" width="56" height="228" rx="28" transform="rotate(90 150 150)"/><rect x="122" y="36" width="56" height="228" rx="28" transform="rotate(135 150 150)"/><circle cx="150" cy="150" r="30"/></g>{%- endcapture -%}
    {%- assign art = 'flower' -%}
{%- endcase -%}
{%- if art != 'capsules' -%}
  <svg class="ff-art ff-art--{{ art }}" viewBox="0 0 300 300" fill="none" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="{{ g }}" cx="58%" cy="58%" r="62%">
        <stop offset="0" style="stop-color: var(--art-a)"/>
        <stop offset="0.6" style="stop-color: var(--art-a); stop-opacity: 0.7"/>
        <stop offset="1" style="stop-color: var(--art-b); stop-opacity: 0.5"/>
      </radialGradient>
      <filter id="{{ b }}" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="6"/>
      </filter>
    </defs>
    <g class="ff-art__fill" fill="url(#{{ g }})" filter="url(#{{ b }})">{{ shape }}</g>
    <g class="ff-art__lines">{{ shape }}</g>
  </svg>
{%- endif -%}
