{%- render 'lml-assets' -%}

<div class="lml-section lml-social" style="background: {{ section.settings.background }};">
  <div class="lml-container">
    <div class="lml-social__head">
      <h2 class="lml-display-2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="lml-btn lml-btn--lime" target="_blank" rel="noopener">
          {{- section.settings.button_label }} <span aria-hidden="true">&nearr;</span>
        </a>
      {%- endif -%}
    </div>
    <div class="lml-social__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: section.settings.button_link | default: '#' }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 1025px) 25vw, 50vw', alt: block.settings.alt }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'lml-placeholder' }}
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LML social",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#dfc8e7" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "lemme socialize" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Follow us" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LML social",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
