{%- render 'ff-assets' -%}

{%- assign bg = section.settings.background -%}

<section
  class="ugc"
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  aria-labelledby="ugc-title-{{ section.id }}"
  {% if bg != blank and bg.alpha != 0.0 %}style="--ff-bg: {{ bg }};"{% endif %}
>
  <h2 class="section-title ugc__title" id="ugc-title-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h2>
  {%- if section.settings.lead != blank -%}
    <p class="ugc__lead">{{ section.settings.lead | escape }}</p>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="ugc__track">
      {%- for block in section.blocks -%}
        {%- capture post_image -%}
          {%- render 'dizzy-image',
            image: block.settings.image,
            asset: block.settings.image_asset,
            width: 580,
            height: 1142,
            alt: block.settings.alt,
            sizes: '(max-width: 767px) 196px, (max-width: 1023px) 240px, 25vw',
            widths: '400,600,900'
          -%}
        {%- endcapture -%}
        <li {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ post_image }}</a>
          {%- else -%}
            {{ post_image }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "FF UGC",
  "class": "ff",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Line breaks show on mobile only." },
    { "type": "text", "id": "lead", "label": "Text" },
    { "type": "header", "content": "Section" },
    { "type": "color", "id": "background", "label": "Background", "info": "Leave empty to use the brand coral." },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Tall portrait, around 580 × 1142px." },
        { "type": "text", "id": "image_asset", "label": "Fallback theme asset", "info": "Used until an image is uploaded." },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional, e.g. the original post." }
      ]
    }
  ],
  "presets": [{ "name": "FF UGC" }]
}
{% endschema %}
