{%- render 'ff-assets' -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign group = 'plan-' | append: section.id
  assign title = section.settings.title | default: product.title

  assign images = product.media | where: 'media_type', 'image'
  assign bullet_blocks = section.blocks | where: 'type', 'bullet'
  assign usp_blocks = section.blocks | where: 'type', 'usp'
  assign pill_blocks = section.blocks | where: 'type', 'pill'
  assign ribbon_blocks = section.blocks | where: 'type', 'ribbon'
  assign option_blocks = section.blocks | where: 'type', 'option'
  assign detail_blocks = section.blocks | where: 'type', 'detail'
  assign guarantee_blocks = section.blocks | where: 'type', 'guarantee'

  # Resolve each purchase option to one of this variant's selling plans.
  # A subscription option can name its plan (as shown in Apps > Subscriptions
  # > Plans) or a plan ID; left empty it takes the product's first plan.
  # resolved_list holds one entry per option: a plan ID, 'once' or 'missing'.
  # Options that can't be offered are skipped; if none can, the product's own
  # selling plans are listed instead.
  # resolved_groups holds each option's selling plan group, so the other
  # frequencies in that group can be offered in a dropdown on the card.
  assign resolved = ''
  assign resolved_groups = ''
  assign valid_ids = ''
  assign selected_id = ''
  for block in option_blocks
    assign entry = 'missing'
    assign entry_group = '-'
    if block.settings.kind == 'one_time'
      unless product.requires_selling_plan
        assign entry = 'once'
      endunless
    else
      assign wanted = block.settings.plan | strip | downcase
      for allocation in variant.selling_plan_allocations
        assign plan = allocation.selling_plan
        assign plan_id = plan.id | append: ''
        assign plan_name = plan.name | downcase
        assign group_name = ''
        for plan_group in product.selling_plan_groups
          assign group_id = plan_group.id | append: ''
          assign alloc_group_id = allocation.selling_plan_group_id | append: ''
          if group_id == alloc_group_id
            assign group_name = plan_group.name | downcase
          endif
        endfor
        if wanted == blank or wanted == plan_id or wanted == group_name or plan_name contains wanted
          assign entry = plan_id
          assign entry_group = allocation.selling_plan_group_id | append: ''
          break
        endif
      endfor
    endif
    assign resolved = resolved | append: entry | append: ','
    assign resolved_groups = resolved_groups | append: entry_group | append: ','
    if entry != 'missing'
      assign valid_ids = valid_ids | append: forloop.index0 | append: ','
      if block.settings.selected and selected_id == blank
        assign selected_id = forloop.index0 | append: ''
      endif
    endif
  endfor
  assign resolved_list = resolved | split: ','
  assign resolved_group_list = resolved_groups | split: ','
  assign valid_list = valid_ids | split: ','
  assign auto_mode = false
  if valid_list.size == 0
    assign auto_mode = true
  elsif selected_id == blank
    assign selected_id = valid_list.first
  endif
  assign start_plan = ''
-%}

{%- capture options_html -%}
  {%- if auto_mode -%}
    {%- assign shown_groups = ',' -%}
    {%- for allocation in variant.selling_plan_allocations -%}
      {%- liquid
        # One card per selling plan group; its other plans go in the dropdown
        assign plan_group = allocation.selling_plan_group_id | append: ''
        assign group_key = ',' | append: plan_group | append: ','
        if shown_groups contains group_key
          continue
        endif
        assign shown_groups = shown_groups | append: plan_group | append: ','

        assign option_title = allocation.selling_plan.name
        assign frequency_count = 0
        for sibling in variant.selling_plan_allocations
          assign sibling_group = sibling.selling_plan_group_id | append: ''
          if sibling_group == plan_group
            assign frequency_count = frequency_count | plus: 1
          endif
        endfor
        if frequency_count > 1
          for plan_group_item in product.selling_plan_groups
            assign group_id = plan_group_item.id | append: ''
            if group_id == plan_group
              assign option_title = plan_group_item.name
            endif
          endfor
        endif

        assign saving = ''
        if allocation.compare_at_price > allocation.price
          assign pct = allocation.compare_at_price | minus: allocation.price | times: 100.0 | divided_by: allocation.compare_at_price | round
          assign saving = 'Save ' | append: pct | append: '%'
        endif
        if forloop.first
          assign start_plan = allocation.selling_plan.id
        endif
      -%}
      {%- render 'ff-plan',
        group: group,
        plan: allocation.selling_plan.id,
        selected: forloop.first,
        title: option_title,
        price: allocation.price,
        compare: allocation.compare_at_price,
        saving: saving,
        allocations: variant.selling_plan_allocations,
        plan_group: plan_group,
        auto_saving: true
      -%}
    {%- endfor -%}
    {%- unless product.requires_selling_plan -%}
      {%- liquid
        assign once_selected = false
        if variant.selling_plan_allocations.size == 0
          assign once_selected = true
        endif
      -%}
      {%- render 'ff-plan',
        group: group,
        plan: '',
        selected: once_selected,
        title: section.settings.once_label,
        price: variant.price
      -%}
    {%- endunless -%}
  {%- else -%}
    {%- for block in option_blocks -%}
      {%- liquid
        assign position = forloop.index0 | append: ''
        assign entry = resolved_list[forloop.index0]
        assign plan_group = resolved_group_list[forloop.index0]
      -%}
      {%- if entry == 'missing' -%}
        {%- if request.design_mode -%}
          <p class="plan-notice" {{ block.shopify_attributes }}>
            {%- if block.settings.kind == 'one_time' -%}
              This product can only be bought on subscription, so the one-time option is hidden.
            {%- elsif block.settings.plan != blank -%}
              Hidden: no subscription plan called “{{ block.settings.plan | escape }}” is on this product. Check the name in Apps › Subscriptions › Plans.
            {%- else -%}
              Hidden: this product isn’t in a subscription plan yet. Add it in Apps › Subscriptions › Plans.
            {%- endif -%}
            <small>Only shown in the theme editor.</small>
          </p>
        {%- endif -%}
        {%- continue -%}
      {%- endif -%}
      {%- liquid
        assign plan_id = entry
        if entry == 'once'
          assign plan_id = ''
        endif
        assign price = variant.price
        assign compare = variant.compare_at_price | default: variant.price
        assign plan_name = ''
        for allocation in variant.selling_plan_allocations
          assign alloc_id = allocation.selling_plan.id | append: ''
          if alloc_id == plan_id
            assign price = allocation.price
            assign compare = allocation.compare_at_price | default: variant.price
            assign plan_name = allocation.selling_plan.name
          endif
        endfor

        assign option_title = block.settings.title
        if option_title == blank
          if plan_id == blank
            assign option_title = section.settings.once_label
          else
            assign option_title = plan_name
          endif
        endif

        # Offer the plan's other frequencies only when no other option uses
        # the same plan, so two cards never show the same dropdown
        assign group_uses = 0
        for other_group in resolved_group_list
          if other_group == plan_group
            assign group_uses = group_uses | plus: 1
          endif
        endfor
        if plan_group == '-' or group_uses > 1
          assign plan_group = ''
        endif

        assign saving = block.settings.saving
        assign auto_saving = false
        if saving == blank
          assign auto_saving = true
        endif
        if saving == blank and compare > price
          assign pct = compare | minus: price | times: 100.0 | divided_by: compare | round
          assign saving = 'Save ' | append: pct | append: '%'
        endif

        assign selected = false
        if position == selected_id
          assign selected = true
          assign start_plan = plan_id
        endif
      -%}
      {%- render 'ff-plan',
        group: group,
        plan: plan_id,
        selected: selected,
        title: option_title,
        price: price,
        compare: compare,
        saving: saving,
        badge: block.settings.badge,
        features: block.settings.features,
        allocations: variant.selling_plan_allocations,
        plan_group: plan_group,
        frequency_label: block.settings.frequency_label,
        auto_saving: auto_saving,
        attributes: block.shopify_attributes
      -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<section
  class="pdp-hero"
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  aria-labelledby="product-title-{{ section.id }}"
  data-ff-product
  data-section-id="{{ section.id }}"
>
  <script type="application/json" data-ff-product-config>
    {
      "available": {{ variant.available | json }},
      "afterAdd": {{ section.settings.after_add | json }},
      "addLabel": {{ section.settings.atc_label | json }},
      "addingLabel": {{ section.settings.adding_label | json }},
      "soldOutLabel": {{ section.settings.sold_out_label | json }}
    }
  </script>

  <div class="pdp-hero__inner">
    <div class="pdp-media{% if images.size > 1 %} pdp-media--thumbs{% endif %}" data-ff-gallery>
      <div class="pdp-media__stage">
        <div class="gallery"{% if images.size > 0 %} style="--gallery-ratio: {{ images.first.preview_image.aspect_ratio }};"{% endif %}>
          <ul class="gallery__track" data-gallery-track tabindex="0" aria-label="{{ title | escape }} images">
            {%- for media in images -%}
              <li class="gallery__slide" data-media-id="{{ media.id }}">
                {%- render 'dizzy-image',
                  image: media.preview_image,
                  alt: media.alt,
                  sizes: '(max-width: 767px) 100vw, (max-width: 1279px) 46vw, 627px',
                  widths: '480,700,1000,1300',
                  priority: forloop.first
                -%}
              </li>
            {%- else -%}
              <li class="gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'gallery__placeholder' }}</li>
            {%- endfor -%}
          </ul>
          {%- if section.settings.tagline != blank -%}
            <p class="gallery__tagline">{{ section.settings.tagline | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if images.size > 1 -%}
            <button class="gallery__arrow gallery__arrow--prev" type="button" aria-label="{{ 'general.slider.previous_slide' | t }}" data-gallery-prev>
              {%- render 'ff-icon', icon: 'arrow', size: 20 -%}
            </button>
            <button class="gallery__arrow gallery__arrow--next" type="button" aria-label="{{ 'general.slider.next_slide' | t }}" data-gallery-next>
              {%- render 'ff-icon', icon: 'arrow', size: 20 -%}
            </button>
          {%- endif -%}
        </div>
        {%- if images.size > 1 -%}
          <ul class="gallery__thumbs" data-gallery-thumbs>
            {%- for media in images -%}
              <li>
                <button
                  class="gallery__thumb"
                  type="button"
                  aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
                  {% if forloop.first %}aria-current="true"{% endif %}
                  data-gallery-thumb="{{ forloop.index0 }}"
                >
                  {{- media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,200', sizes: '64px', alt: '' -}}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- liquid
        assign show_label = false
        if section.settings.label_image != blank or section.settings.label_image_url != blank
          assign show_label = true
        endif
        assign label_text = section.settings.label_button | default: 'View Nutrient Label'
      -%}
      {%- if show_label -%}
        <button class="label-btn" type="button" aria-haspopup="dialog" data-ff-dialog-open="label-{{ section.id }}">
          {{- label_text | escape -}}
        </button>
      {%- endif -%}
    </div>

    <div class="buybox">
      <div class="buybox__head">
        {%- if section.settings.show_rating -%}
          <p class="buybox__rating">
            <span class="buybox__stars" role="img" aria-label="{% if section.settings.rating != blank %}Rated {{ section.settings.rating | escape }} out of 5{% else %}5 star rating{% endif %}">
              {%- for i in (1..5) -%}
                <img src="{{ 'ff-icon-rating-star.svg' | asset_url }}" width="31" height="31" alt="">
              {%- endfor -%}
            </span>
            {%- if section.settings.rating != blank -%}
              <span aria-hidden="true">{{ section.settings.rating | escape }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}

        <h1 class="buybox__title" id="product-title-{{ section.id }}">{{ title | escape }}</h1>

        {%- if section.settings.description != blank -%}
          <div class="buybox__lead">{{ section.settings.description }}</div>
        {%- elsif product.description != blank -%}
          <div class="buybox__lead">{{ product.description }}</div>
        {%- endif -%}

        {%- if pill_blocks.size > 0 -%}
          {%- liquid
            # Every look setting becomes a CSS variable on the list; a pill's
            # own colours and image override them on that pill only.
            assign ps = section.settings
            capture pill_style
              echo '--pill-cols: ' | append: ps.pill_columns | append: ';'
              echo '--pill-cols-m: ' | append: ps.pill_columns_mobile | append: ';'
              echo '--pill-gap: ' | append: ps.pill_gap | append: 'px;'
              echo '--pill-gap-m: ' | append: ps.pill_gap_mobile | append: 'px;'
              echo '--pill-h: ' | append: ps.pill_height | append: 'px;'
              echo '--pill-h-m: ' | append: ps.pill_height_mobile | append: 'px;'
              echo '--pill-px: ' | append: ps.pill_padding | append: 'px;'
              echo '--pill-radius: ' | append: ps.pill_radius | append: 'px;'
              echo '--pill-border-w: ' | append: ps.pill_border_width | append: 'px;'
              echo '--pill-fs: ' | append: ps.pill_font_size | append: 'px;'
              echo '--pill-fs-m: ' | append: ps.pill_font_size_mobile | append: 'px;'
              echo '--pill-fw: ' | append: ps.pill_font_weight | append: ';'
              echo '--pill-tt: ' | append: ps.pill_text_transform | append: ';'
              echo '--pill-icon: ' | append: ps.pill_icon_size | append: 'px;'
              echo '--pill-icon-m: ' | append: ps.pill_icon_size_mobile | append: 'px;'
              echo '--pill-icon-gap: ' | append: ps.pill_icon_gap | append: 'px;'
              if ps.pill_background != blank and ps.pill_background.alpha != 0.0
                echo '--pill-bg: ' | append: ps.pill_background | append: ';'
              endif
              if ps.pill_gradient != blank
                echo '--pill-grad: ' | append: ps.pill_gradient | append: ';'
              endif
              if ps.pill_image != blank
                echo '--pill-img: url(' | append: ps.pill_image | image_url: width: 1000 | append: ');'
              endif
              if ps.pill_text_color != blank and ps.pill_text_color.alpha != 0.0
                echo '--pill-fg: ' | append: ps.pill_text_color | append: ';'
              endif
              if ps.pill_border_color != blank and ps.pill_border_color.alpha != 0.0
                echo '--pill-border-c: ' | append: ps.pill_border_color | append: ';'
              endif
            endcapture
          -%}
          <ul
            class="buybox__pills buybox__pills--icon-{{ ps.pill_icon_position }} buybox__pills--align-{{ ps.pill_align }}{% if ps.pill_shadow %} buybox__pills--shadow{% endif %}"
            style="{{ pill_style | strip_newlines }}"
          >
            {%- for block in pill_blocks -%}
              {%- liquid
                assign bs = block.settings
                capture own_style
                  if bs.background != blank and bs.background.alpha != 0.0
                    echo '--pill-bg: ' | append: bs.background | append: ';'
                  endif
                  if bs.gradient != blank
                    echo '--pill-grad: ' | append: bs.gradient | append: ';'
                  endif
                  if bs.image != blank
                    echo '--pill-img: url(' | append: bs.image | image_url: width: 1000 | append: ');'
                  endif
                  if bs.text_color != blank and bs.text_color.alpha != 0.0
                    echo '--pill-fg: ' | append: bs.text_color | append: ';'
                  endif
                endcapture
                assign icon_src = bs.icon.src | downcase
              -%}
              <li class="buybox__pill"{% if own_style != blank %} style="{{ own_style | strip_newlines }}"{% endif %} {{ block.shopify_attributes }}>
                {%- if bs.link != blank -%}<a class="buybox__pill-inner" href="{{ bs.link }}">{%- else -%}<span class="buybox__pill-inner">{%- endif -%}
                  {%- if bs.icon != blank -%}
                    {%- if icon_src contains '.gif' -%}
                      {%- comment -%} GIFs load at full size so they keep animating. {%- endcomment -%}
                      {{- bs.icon | image_url | image_tag: class: 'buybox__pill-icon', loading: 'lazy', alt: '' -}}
                    {%- else -%}
                      {{- bs.icon | image_url: width: 160 | image_tag: class: 'buybox__pill-icon', widths: '64,96,160', sizes: '48px', loading: 'lazy', alt: '' -}}
                    {%- endif -%}
                  {%- elsif bs.icon_url != blank -%}
                    <img class="buybox__pill-icon" src="{{ bs.icon_url | escape }}" width="{{ ps.pill_icon_size }}" height="{{ ps.pill_icon_size }}" loading="lazy" alt="">
                  {%- endif -%}
                  <span class="buybox__pill-text">{{ bs.text | escape }}</span>
                {%- if bs.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if bullet_blocks.size > 0 -%}
          <ul class="buybox__bullets">
            {%- for block in bullet_blocks -%}
              <li {{ block.shopify_attributes }}>
                <svg class="buybox__tick" width="14" height="11" viewBox="0 0 14 11" fill="none" aria-hidden="true" focusable="false">
                  <path d="M1.5 5.5 5 9l7.5-7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- unless product.has_only_default_variant -%}
          <div class="variant-picker" data-ff-variant-picker>
            <script type="application/json" data-ff-variants>
              [
                {%- for v in product.variants -%}
                  {"id": {{ v.id }}, "options": {{ v.options | json }}, "media": {{ v.featured_media.id | json }}}
                  {%- unless forloop.last %},{% endunless -%}
                {%- endfor -%}
              ]
            </script>
            {%- for option in product.options_with_values -%}
              <fieldset class="variant-picker__option">
                <legend class="variant-picker__label">
                  {{- option.name | escape }}: <span>{{ option.selected_value | escape }}</span>
                </legend>
                <div class="variant-picker__values">
                  {%- for value in option.values -%}
                    <label class="variant-picker__value{% unless value.available %} is-unavailable{% endunless %}">
                      <input
                        class="variant-picker__input"
                        type="radio"
                        name="option-{{ section.id }}-{{ option.position }}"
                        value="{{ value | escape }}"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        {% if value.selected %}checked{% endif %}
                      >
                      <span class="variant-picker__box">{{ value | escape }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- for block in ribbon_blocks -%}
          {%- liquid
            # Every look setting becomes a CSS variable on the ribbon
            assign bs = block.settings
            capture ribbon_style
              echo '--ribbon-h: ' | append: bs.height | append: 'px;'
              echo '--ribbon-h-m: ' | append: bs.height_mobile | append: 'px;'
              echo '--ribbon-px: ' | append: bs.padding_x | append: 'px;'
              echo '--ribbon-py: ' | append: bs.padding_y | append: 'px;'
              echo '--ribbon-radius: ' | append: bs.radius | append: 'px;'
              echo '--ribbon-border-w: ' | append: bs.border_width | append: 'px;'
              echo '--ribbon-fs: ' | append: bs.font_size | append: 'px;'
              echo '--ribbon-fs-m: ' | append: bs.font_size_mobile | append: 'px;'
              echo '--ribbon-fw: ' | append: bs.font_weight | append: ';'
              echo '--ribbon-icon: ' | append: bs.icon_size | append: 'px;'
              echo '--ribbon-icon-m: ' | append: bs.icon_size_mobile | append: 'px;'
              echo '--ribbon-gap: ' | append: bs.icon_gap | append: 'px;'
              if bs.background != blank and bs.background.alpha != 0.0
                echo '--ribbon-bg: ' | append: bs.background | append: ';'
              endif
              if bs.gradient != blank
                echo '--ribbon-grad: ' | append: bs.gradient | append: ';'
              endif
              if bs.image != blank
                echo '--ribbon-img: url(' | append: bs.image | image_url: width: 1400 | append: ');'
              endif
              if bs.text_color != blank and bs.text_color.alpha != 0.0
                echo '--ribbon-fg: ' | append: bs.text_color | append: ';'
              endif
              if bs.border_color != blank and bs.border_color.alpha != 0.0
                echo '--ribbon-border-c: ' | append: bs.border_color | append: ';'
              endif
            endcapture
            assign icon_src = bs.icon.src | downcase
          -%}
          <div
            class="ribbon ribbon--icon-{{ bs.icon_position }} ribbon--align-{{ bs.align }}{% if bs.shadow %} ribbon--shadow{% endif %}"
            style="{{ ribbon_style | strip_newlines }}"
            {{ block.shopify_attributes }}
          >
            {%- if bs.link != blank -%}<a class="ribbon__inner" href="{{ bs.link }}">{%- else -%}<div class="ribbon__inner">{%- endif -%}
              {%- if bs.icon != blank -%}
                {%- if icon_src contains '.gif' -%}
                  {%- comment -%} GIFs load at full size so they keep animating. {%- endcomment -%}
                  {{- bs.icon | image_url | image_tag: class: 'ribbon__icon', loading: 'lazy', alt: '' -}}
                {%- else -%}
                  {{- bs.icon | image_url: width: 160 | image_tag: class: 'ribbon__icon', widths: '64,96,160', sizes: '48px', loading: 'lazy', alt: '' -}}
                {%- endif -%}
              {%- elsif bs.icon_url != blank -%}
                <img class="ribbon__icon" src="{{ bs.icon_url | escape }}" width="{{ bs.icon_size }}" height="{{ bs.icon_size }}" loading="lazy" alt="">
              {%- endif -%}
              <div class="ribbon__text">{{ bs.text }}</div>
            {%- if bs.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </div>
        {%- endfor -%}

        {%- if usp_blocks.size > 0 -%}
          <ul class="buybox__usps">
            {%- for block in usp_blocks -%}
              <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- form 'product', product, class: 'buy-form', novalidate: 'novalidate', data-ff-buy-form: 'true' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
        <input type="hidden" name="selling_plan" value="{{ start_plan }}" data-ff-plan{% if start_plan == blank %} disabled{% endif %}>

        <fieldset class="plans">
          <legend class="visually-hidden">{{ section.settings.legend | default: 'Choose how to buy' | escape }}</legend>
          {{ options_html }}
        </fieldset>

        <div class="buy-form__row">
          <button class="btn btn--atc" type="submit"{% unless variant.available %} disabled{% endunless %}>
            {%- if variant.available -%}
              {{ section.settings.atc_label | escape }}
            {%- else -%}
              {{ section.settings.sold_out_label | escape }}
            {%- endif -%}
          </button>
        </div>

        {%- if section.settings.show_dynamic_checkout -%}
          <div class="buy-form__checkout">{{ form | payment_button }}</div>
        {%- endif -%}
        <p class="buy-form__error" role="alert" hidden data-ff-buy-error></p>
      {%- endform -%}

      {%- for block in guarantee_blocks -%}
        {%- render 'ff-guarantee', block: block -%}
      {%- endfor -%}

      {%- if detail_blocks.size > 0 -%}
        <div class="pdp-acc" data-ff-details>
          {%- for block in detail_blocks -%}
            <div
              class="pdp-acc__item{% if block.settings.open %} is-open{% endif %}"
              {% if block.settings.open %}data-open-from="768"{% endif %}
              {{ block.shopify_attributes }}
            >
              <h2>
                <button
                  class="pdp-acc__q"
                  id="pdp-q-{{ block.id }}"
                  type="button"
                  aria-expanded="{{ block.settings.open }}"
                  aria-controls="pdp-a-{{ block.id }}"
                >
                  {{ block.settings.title | escape }}
                  <span class="pdp-acc__icon" aria-hidden="true">
                    <img class="pdp-acc__minus" src="{{ 'ff-icon-minus.svg' | asset_url }}" width="20" height="20" alt="">
                    <img class="pdp-acc__plus" src="{{ 'ff-icon-plus-sm.svg' | asset_url }}" width="18" height="18" alt="">
                  </span>
                </button>
              </h2>
              <div class="pdp-acc__a" id="pdp-a-{{ block.id }}" role="region" aria-labelledby="pdp-q-{{ block.id }}">
                <div class="pdp-acc__content">{{ block.settings.content }}</div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if show_label -%}
    <dialog class="label-modal" id="label-{{ section.id }}" aria-label="{{ label_text | escape }}">
      <form method="dialog">
        <button class="label-modal__close" type="submit" aria-label="{{ 'accessibility.close' | t }}">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <path d="m4 4 12 12M16 4 4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </form>
      {%- if section.settings.label_image != blank -%}
        {%- render 'dizzy-image',
          image: section.settings.label_image,
          class: 'label-modal__img',
          sizes: '(max-width: 767px) 92vw, 720px',
          widths: '600,900,1200,1600'
        -%}
      {%- else -%}
        <img class="label-modal__img" src="{{ section.settings.label_image_url | escape }}" loading="lazy" alt="Nutrient label">
      {%- endif -%}
    </dialog>
  {%- endif -%}

  {%- comment -%}
    Sticky add to basket (mobile only): title, the chosen option's price and
    an add button that submits the buy form. Shown while neither the form's
    own button nor the footer is on screen.
  {%- endcomment -%}
  {%- if section.settings.show_sticky_atc -%}
    <div class="sticky-atc" aria-hidden="true" inert data-ff-sticky-atc>
      <div class="sticky-atc__info">
        <p class="sticky-atc__title">{{ title | escape }}</p>
        <p class="sticky-atc__price" data-ff-sticky-price></p>
      </div>
      <button class="btn btn--atc" type="button"{% unless variant.available %} disabled{% endunless %} data-ff-sticky-add>
        {%- if variant.available -%}
          {{ section.settings.atc_label | escape }}
        {%- else -%}
          {{ section.settings.sold_out_label | escape }}
        {%- endif -%}
      </button>
    </div>
  {%- endif -%}
</section>

