{%- render 'dizzy-assets' -%}

<div class="announcement">
  <p>
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      {{ section.settings.text | escape }}
    {%- endif -%}
  </p>
</div>

{% schema %}
{
  "name": "DIZZY announcement",
  "class": "dizzy",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Selfish by design." },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "DIZZY announcement" }]
}
{% endschema %}
