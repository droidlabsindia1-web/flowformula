{%- render 'ff-assets' -%}

{%- assign bg = section.settings.background -%}
{%- assign text_color = section.settings.text_color -%}

{%- if section.blocks.size > 0 -%}
  <section
    class="usp-strip"
    aria-label="{{ section.settings.label | default: 'Product highlights' | escape }}"
    style="
      {%- if bg != blank and bg.alpha != 0.0 %}--ff-bg: {{ bg }};{% endif -%}
      {%- if text_color != blank and text_color.alpha != 0.0 %}--ff-text: {{ text_color }};{% endif -%}
    "
  >
    <div class="usp-strip__track">
      {%- comment -%} Four copies so one copy's width always covers wide screens; the track loops by one copy. {%- endcomment -%}
      {%- for copy in (1..4) -%}
        <ul class="usp-strip__list{% if copy > 1 %} usp-strip__list--clone{% endif %}"{% if copy > 1 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <li {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}"{% if copy > 1 %} tabindex="-1"{% endif %}>{{ block.settings.text | escape }}</a>
              {%- else -%}
                {{ block.settings.text | escape }}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "FF highlights strip",
  "class": "ff",
  "settings": [
    { "type": "paragraph", "content": "Scrolls continuously as a marquee on all screen sizes." },
    { "type": "text", "id": "label", "label": "Label (screen readers)" },
    { "type": "color", "id": "background", "label": "Background", "info": "Leave empty to use the brand peach." },
    { "type": "color", "id": "text_color", "label": "Text", "info": "Leave empty to use the brand ink." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Highlight",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "FF highlights strip" }]
}
{% endschema %}
