{%- render 'ff-assets' -%}

{%- assign bg = section.settings.background -%}
{%- assign text_color = section.settings.text_color -%}

{%- if section.blocks.size > 0 -%}
  <section
    class="trust-bar{% if section.settings.show_on_mobile %} trust-bar--mobile{% endif %}"
    {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
    style="
      {%- if bg != blank and bg.alpha != 0.0 %}--ff-bg: {{ bg }};{% endif -%}
      {%- if text_color != blank and text_color.alpha != 0.0 %}--ff-text: {{ text_color }};{% endif -%}
    "
  >
    <div class="trust-bar__track">
      {%- comment -%} Four copies so one copy's width always covers wide screens; the track loops by one copy. {%- endcomment -%}
      {%- for copy in (1..4) -%}
        <ul class="trust-bar__list"{% if copy > 1 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <li {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}>
              {%- if block.settings.icon_image != blank -%}
                {{ block.settings.icon_image | image_url: width: 48 | image_tag: width: 24, height: 24, alt: '', class: 'trust-bar__icon' }}
              {%- endif -%}
              {{ block.settings.text | escape }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "FF trust bar",
  "class": "ff",
  "settings": [
    { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "info": "Hidden below 768px unless checked." },
    { "type": "color", "id": "background", "label": "Background", "info": "Leave empty to use the brand navy." },
    { "type": "color", "id": "text_color", "label": "Text", "info": "Leave empty to use white at 70% opacity." },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Icon", "info": "Shown at 24 × 24px. Square PNG or SVG works best." },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "FF trust bar" }]
}
{% endschema %}
