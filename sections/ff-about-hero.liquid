{%- render 'ff-assets' -%}
{{ 'ff-about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ff-about.js' | asset_url }}" defer="defer"></script>

{%- liquid
  # Every look setting becomes a CSS variable on the section
  assign s = section.settings
  if s.heading_font == 'sans'
    assign heading_stack = 'var(--font-sans)'
    assign heading_weight = '600'
  else
    assign heading_stack = 'var(--font-title)'
    assign heading_weight = '400'
  endif
  if s.shape == 'pill'
    assign frame_radius = '9999px'
    assign frame_radius_m = '9999px'
  else
    assign frame_radius = s.radius | append: 'px'
    assign frame_radius_m = s.radius_mobile | append: 'px'
  endif

  assign zoom_scale = s.zoom_amount | divided_by: 100.0 | plus: 1

  capture hero_style
    echo '--ah-heading-font: ' | append: heading_stack | append: ';'
    echo '--about-h-wt: ' | append: heading_weight | append: ';'
    echo '--ah-bg-top: ' | append: s.background_top | append: ';'
    echo '--ah-bg-bottom: ' | append: s.background_bottom | append: ';'
    echo '--ah-heading-c: ' | append: s.heading_color | append: ';'
    echo '--ah-text-c: ' | append: s.text_color | append: ';'
    echo '--ah-overlay: ' | append: s.overlay_color | append: ';'
    echo '--ah-overlay-a: ' | append: s.overlay_opacity | append: '%;'
    echo '--ah-radius: ' | append: frame_radius | append: ';'
    echo '--ah-radius-m: ' | append: frame_radius_m | append: ';'
    echo '--ah-container: ' | append: s.container_width | append: 'px;'
    echo '--ah-px: ' | append: s.side_padding | append: 'px;'
    echo '--ah-px-m: ' | append: s.side_padding_mobile | append: 'px;'
    echo '--ah-pt: ' | append: s.padding_top | append: 'px;'
    echo '--ah-pt-m: ' | append: s.padding_top_mobile | append: 'px;'
    echo '--ah-pb: ' | append: s.padding_bottom | append: 'px;'
    echo '--ah-pb-m: ' | append: s.padding_bottom_mobile | append: 'px;'
    echo '--ah-offset: ' | append: s.height_offset | append: 'px;'
    echo '--ah-offset-m: ' | append: s.height_offset_mobile | append: 'px;'
    echo '--ah-min-h: ' | append: s.min_height | append: 'px;'
    echo '--ah-min-h-m: ' | append: s.min_height_mobile | append: 'px;'
    echo '--ah-h-fs: ' | append: s.heading_size | append: 'px;'
    echo '--ah-h-fs-m: ' | append: s.heading_size_mobile | append: 'px;'
    echo '--ah-h-ls: ' | append: s.heading_letter_spacing | append: 'px;'
    echo '--ah-h-w: ' | append: s.heading_width | append: 'px;'
    echo '--ah-text-fs: ' | append: s.text_size | append: 'px;'
    echo '--ah-text-fs-m: ' | append: s.text_size_mobile | append: 'px;'
    echo '--ah-text-w: ' | append: s.text_width | append: 'px;'
    echo '--ah-zoom: ' | append: zoom_scale | append: ';'
    echo '--ah-zoom-time: ' | append: s.zoom_duration | append: 's;'
  endcapture

  assign classes = 'about-hero'
  if s.zoom
    assign classes = classes | append: ' about-hero--zoom'
  endif
  if s.text_shadow
    assign classes = classes | append: ' about-hero--shadow'
  endif
  if s.background_scroll
    assign classes = classes | append: ' about-hero--bg-scroll'
  endif

  assign heading_tag = s.heading_tag | default: 'h1'
-%}

<section
  class="{{ classes }}"
  {% if s.anchor_id != blank %}id="{{ s.anchor_id | handleize }}"{% endif %}
  style="{{ hero_style | strip_newlines }}"
  {% if s.heading != blank %}aria-labelledby="about-hero-title-{{ section.id }}"{% endif %}
  data-ff-about-hero
>
  <div class="about-hero__container">
    <div class="about-hero__frame">
      <div class="about-hero__media" aria-hidden="true">
        {%- if s.image != blank -%}
          {%- liquid
            assign img_class = 'about-hero__img'
            if s.image_mobile != blank
              assign img_class = 'about-hero__img about-hero__img--desktop'
            endif
            assign focal = s.image.presentation.focal_point | default: 'center'
            assign focal_style = 'object-position: ' | append: focal | append: ';'
          -%}
          {%- render 'dizzy-image',
            image: s.image,
            decorative: true,
            class: img_class,
            style: focal_style,
            sizes: 'calc(100vw - 16px)',
            widths: '750,1100,1500,2000,2600',
            priority: true
          -%}
          {%- if s.image_mobile != blank -%}
            {%- liquid
              assign focal_m = s.image_mobile.presentation.focal_point | default: 'center'
              assign focal_m_style = 'object-position: ' | append: focal_m | append: ';'
            -%}
            {%- render 'dizzy-image',
              image: s.image_mobile,
              decorative: true,
              class: 'about-hero__img about-hero__img--mobile',
              style: focal_m_style,
              sizes: 'calc(100vw - 16px)',
              widths: '480,750,1100',
              priority: true
            -%}
          {%- endif -%}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'about-hero__img about-hero__placeholder' }}
        {%- endif -%}
      </div>

      <div class="about-hero__overlay" aria-hidden="true"></div>

      <div class="about-hero__content">
        {%- if s.heading != blank -%}
          <{{ heading_tag }} class="about-hero__title ff-case--{{ s.heading_case | default: 'none' }}" id="about-hero-title-{{ section.id }}">{{ s.heading | escape }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="about-hero__text">{{ s.text }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FF about hero",
  "class": "ff",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Helping women feel their best, from the inside out" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Women’s health has been overlooked for far too long. Flow Formula brings the daily essentials together in one simple sachet, so feeling like yourself is easy.</p>" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Keep H1 when this is the first section on the page.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Landscape, around 2600 × 1300px. Set the focal point on the image to control cropping." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional. Portrait works best. Uses the main image when empty." },
    { "type": "checkbox", "id": "zoom", "label": "Slow zoom on the image", "default": true },
    { "type": "range", "id": "zoom_amount", "label": "Zoom amount", "min": 2, "max": 25, "step": 1, "unit": "%", "default": 10 },
    { "type": "range", "id": "zoom_duration", "label": "Zoom duration", "min": 5, "max": 60, "step": 1, "unit": "s", "default": 25 },

    { "type": "header", "content": "Overlay" },
    { "type": "color", "id": "overlay_color", "label": "Colour", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 35 },
    { "type": "checkbox", "id": "text_shadow", "label": "Soft shadow behind text", "default": false },

    { "type": "header", "content": "Background" },
    { "type": "color", "id": "background_top", "label": "Top colour", "default": "#FFB3AB" },
    { "type": "color", "id": "background_bottom", "label": "Bottom colour", "info": "Match this to the background of the next section so they blend.", "default": "#FEF6F2" },
    { "type": "checkbox", "id": "background_scroll", "label": "Blend the colours as the page scrolls", "default": true },

    { "type": "header", "content": "Shape and size" },
    {
      "type": "select",
      "id": "shape",
      "label": "Image shape",
      "options": [
        { "value": "pill", "label": "Pill (fully rounded ends)" },
        { "value": "rounded", "label": "Rounded corners" }
      ],
      "default": "rounded"
    },
    { "type": "range", "id": "radius", "label": "Corner radius on desktop", "info": "With rounded corners.", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "radius_mobile", "label": "Corner radius on mobile", "info": "With rounded corners.", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "height_offset", "label": "Desktop height: screen height minus", "info": "Leaves room for the header so the image fits the first screen.", "min": 0, "max": 400, "step": 5, "unit": "px", "default": 140 },
    { "type": "range", "id": "min_height", "label": "Minimum height on desktop", "min": 320, "max": 900, "step": 10, "unit": "px", "default": 520 },
    { "type": "range", "id": "height_offset_mobile", "label": "Mobile height: screen height minus", "info": "Tablets use a fixed wide shape instead.", "min": 0, "max": 400, "step": 5, "unit": "px", "default": 130 },
    { "type": "range", "id": "min_height_mobile", "label": "Minimum height on mobile", "min": 300, "max": 800, "step": 10, "unit": "px", "default": 460 },
    { "type": "range", "id": "container_width", "label": "Maximum width", "min": 1000, "max": 2000, "step": 10, "unit": "px", "default": 1600 },
    { "type": "range", "id": "side_padding", "label": "Side space on desktop", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "side_padding_mobile", "label": "Side space on mobile", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_top", "label": "Top space on desktop", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top space on mobile", "min": 0, "max": 80, "step": 1, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom space on desktop", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom space on mobile", "min": 0, "max": 80, "step": 1, "unit": "px", "default": 8 },

    { "type": "header", "content": "Typography" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "title", "label": "Brand title font" },
        { "value": "sans", "label": "Montserrat" }
      ],
      "default": "title"
    },
    { "type": "range", "id": "heading_size", "label": "Heading size on desktop", "info": "Scaled down on smaller laptops and tablets.", "min": 24, "max": 100, "step": 1, "unit": "px", "default": 60 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on mobile", "min": 20, "max": 60, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "heading_letter_spacing", "label": "Heading letter spacing", "min": -3, "max": 3, "step": 0.1, "unit": "px", "default": -1.3 },
    { "type": "range", "id": "heading_width", "label": "Heading maximum width", "min": 300, "max": 1200, "step": 10, "unit": "px", "default": 820 },
    {
      "type": "select",
      "id": "heading_case",
      "label": "Heading text case",
      "info": "First word capital only also lowercases names, e.g. Flow Formula.",
      "options": [
        { "value": "none", "label": "As typed" },
        { "value": "lowercase", "label": "lowercase" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalise Each Word" },
        { "value": "sentence", "label": "First word capital only" }
      ],
      "default": "none"
    },
    { "type": "range", "id": "text_size", "label": "Text size on desktop", "min": 12, "max": 30, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "text_size_mobile", "label": "Text size on mobile", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "text_width", "label": "Text maximum width", "min": 280, "max": 1000, "step": 10, "unit": "px", "default": 560 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F4ECE8" },

    { "type": "header", "content": "Section" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Lets menu links jump here, e.g. #about." }
  ],
  "presets": [
    { "name": "FF about hero" }
  ]
}
{% endschema %}
