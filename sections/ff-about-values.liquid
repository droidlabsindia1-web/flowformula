{%- render 'ff-assets' -%}
{{ 'ff-about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ff-about.js' | asset_url }}" defer="defer"></script>

{%- liquid
  # Every look setting becomes a CSS variable on the section
  assign s = section.settings
  if s.heading_font == 'sans'
    assign heading_stack = 'var(--font-sans)'
    assign heading_weight = '600'
  else
    assign heading_stack = 'var(--font-title)'
    assign heading_weight = '400'
  endif

  capture values_style
    echo '--av-heading-font: ' | append: heading_stack | append: ';'
    echo '--about-h-wt: ' | append: heading_weight | append: ';'
    echo '--av-page-bg: ' | append: s.page_background | append: ';'
    echo '--av-bg: ' | append: s.background | append: ';'
    echo '--av-heading-c: ' | append: s.heading_color | append: ';'
    echo '--av-card-bg: ' | append: s.card_background | append: ';'
    echo '--av-card-title-c: ' | append: s.card_title_color | append: ';'
    echo '--av-card-text-c: ' | append: s.card_text_color | append: ';'
    echo '--art-a: ' | append: s.art_color_deep | append: ';'
    echo '--art-b: ' | append: s.art_color_light | append: ';'
    echo '--art-line: ' | append: s.art_line_color | append: ';'
    echo '--av-container: ' | append: s.container_width | append: 'px;'
    echo '--av-radius: ' | append: s.radius | append: 'px;'
    echo '--av-radius-m: ' | append: s.radius_mobile | append: 'px;'
    echo '--av-card-radius: ' | append: s.card_radius | append: 'px;'
    echo '--av-card-radius-m: ' | append: s.card_radius_mobile | append: 'px;'
    echo '--av-gap: ' | append: s.card_gap | append: 'px;'
    echo '--av-art: ' | append: s.art_size | append: 'px;'
    echo '--av-art-m: ' | append: s.art_size_mobile | append: 'px;'
    echo '--av-py: ' | append: s.padding | append: 'px;'
    echo '--av-py-m: ' | append: s.padding_mobile | append: 'px;'
    echo '--av-mt: ' | append: s.margin_top | append: 'px;'
    echo '--av-mb: ' | append: s.margin_bottom | append: 'px;'
    echo '--av-mt-m: ' | append: s.margin_top_mobile | append: 'px;'
    echo '--av-mb-m: ' | append: s.margin_bottom_mobile | append: 'px;'
    echo '--av-h-fs: ' | append: s.heading_size | append: 'px;'
    echo '--av-h-fs-m: ' | append: s.heading_size_mobile | append: 'px;'
    echo '--av-h-ls: ' | append: s.heading_letter_spacing | append: 'px;'
    echo '--av-t-fs: ' | append: s.card_title_size | append: 'px;'
    echo '--av-t-fs-m: ' | append: s.card_title_size_mobile | append: 'px;'
    echo '--av-text-fs: ' | append: s.card_text_size | append: 'px;'
    echo '--av-text-fs-m: ' | append: s.card_text_size_mobile | append: 'px;'
  endcapture

  assign classes = 'about-values'
  if s.art_animate
    assign classes = classes | append: ' about-values--animate'
  endif
  if s.full_width
    assign classes = classes | append: ' about-values--full'
  endif
-%}

<section
  class="{{ classes }}"
  {% if s.anchor_id != blank %}id="{{ s.anchor_id | handleize }}"{% endif %}
  style="{{ values_style | strip_newlines }}"
  {% if s.heading != blank %}aria-labelledby="about-values-title-{{ section.id }}"{% endif %}
  data-ff-about-values
>
  <div class="about-values__panel">
    <div class="about-values__container">
      {%- if s.heading != blank -%}
        <h2 class="about-values__title ff-case--{{ s.heading_case | default: 'none' }}" id="about-values-title-{{ section.id }}">{{ s.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        {%- liquid
          # Up to four cards sit in one row; five or six wrap in rows of three
          assign cols = section.blocks.size
          if cols > 4
            assign cols = 3
          endif
        -%}
        <ul class="about-values__grid" style="--av-cols: {{ cols }};" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign b = block.settings
              assign uid = section.id | append: '-' | append: block.id
            -%}
            <li class="about-values__card" {{ block.shopify_attributes }}>
              {%- if b.image != blank or b.art != 'none' -%}
                <div class="about-values__art" aria-hidden="true">
                  {%- if b.image != blank -%}
                    {%- render 'dizzy-image',
                      image: b.image,
                      decorative: true,
                      class: 'about-values__art-img',
                      sizes: '(min-width: 1024px) 320px, 200px',
                      widths: '400,640'
                    -%}
                  {%- else -%}
                    <span class="about-values__glow"></span>
                    {%- render 'ff-about-art', art: b.art, uid: uid -%}
                    <span class="about-values__grain"></span>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if b.title != blank -%}
                <h3 class="about-values__card-title ff-case--{{ s.card_title_case | default: 'none' }}">{{ b.title | escape }}</h3>
              {%- endif -%}
              {%- if b.text != blank -%}
                <div class="about-values__card-text">{{ b.text }}</div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FF about values",
  "class": "ff",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our values" },

    { "type": "header", "content": "Artwork" },
    { "type": "checkbox", "id": "art_animate", "label": "Animate the artwork", "info": "Plays gently while the card is on screen.", "default": true },
    { "type": "color", "id": "art_color_deep", "label": "Deep colour", "default": "#FE686E" },
    { "type": "color", "id": "art_color_light", "label": "Light colour", "default": "#FFB1A4" },
    { "type": "color", "id": "art_line_color", "label": "Outline colour", "default": "#FFFFFF" },
    { "type": "range", "id": "art_size", "label": "Artwork size on desktop", "info": "Shrinks to fit narrower cards.", "min": 160, "max": 400, "step": 5, "unit": "px", "default": 300 },
    { "type": "range", "id": "art_size_mobile", "label": "Artwork size on mobile", "min": 120, "max": 320, "step": 5, "unit": "px", "default": 200 },

    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "full_width", "label": "Full width panel", "default": true },
    { "type": "range", "id": "container_width", "label": "Maximum content width", "min": 960, "max": 1800, "step": 10, "unit": "px", "default": 1440 },
    { "type": "range", "id": "radius", "label": "Panel corner radius on desktop", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "radius_mobile", "label": "Panel corner radius on mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius on desktop", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_radius_mobile", "label": "Card corner radius on mobile", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "card_gap", "label": "Space between cards", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding", "label": "Top and bottom space inside on desktop", "min": 24, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_mobile", "label": "Top and bottom space inside on mobile", "min": 16, "max": 120, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "margin_top", "label": "Top margin on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Bottom margin on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_top_mobile", "label": "Top margin on mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom_mobile", "label": "Bottom margin on mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },

    { "type": "header", "content": "Typography" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Used for the section heading and card titles.",
      "options": [
        { "value": "title", "label": "Brand title font" },
        { "value": "sans", "label": "Montserrat" }
      ],
      "default": "title"
    },
    { "type": "range", "id": "heading_size", "label": "Heading size on desktop", "info": "Scaled down on smaller laptops and tablets.", "min": 24, "max": 100, "step": 1, "unit": "px", "default": 50 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on mobile", "min": 20, "max": 60, "step": 1, "unit": "px", "default": 36 },
    { "type": "range", "id": "heading_letter_spacing", "label": "Heading letter spacing", "min": -3, "max": 3, "step": 0.1, "unit": "px", "default": -1.3 },
    {
      "type": "select",
      "id": "heading_case",
      "label": "Heading text case",
      "info": "First word capital only also lowercases names, e.g. Flow Formula.",
      "options": [
        { "value": "none", "label": "As typed" },
        { "value": "lowercase", "label": "lowercase" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalise Each Word" },
        { "value": "sentence", "label": "First word capital only" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "card_title_case",
      "label": "Card title text case",
      "info": "First word capital only also lowercases names, e.g. Flow Formula.",
      "options": [
        { "value": "none", "label": "As typed" },
        { "value": "lowercase", "label": "lowercase" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalise Each Word" },
        { "value": "sentence", "label": "First word capital only" }
      ],
      "default": "none"
    },
    { "type": "range", "id": "card_title_size", "label": "Card title size on desktop", "min": 18, "max": 64, "step": 1, "unit": "px", "default": 34 },
    { "type": "range", "id": "card_title_size_mobile", "label": "Card title size on mobile", "min": 16, "max": 48, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "card_text_size", "label": "Card text size on desktop", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_text_size_mobile", "label": "Card text size on mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "page_background", "label": "Behind the panel", "info": "Shows at the rounded corners. Match it to the section above.", "default": "#FEF6F2" },
    { "type": "color", "id": "background", "label": "Panel", "default": "#FFB3AB" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#152340" },
    { "type": "color", "id": "card_background", "label": "Card", "default": "#FEF6F2" },
    { "type": "color", "id": "card_title_color", "label": "Card title", "default": "#152340" },
    { "type": "color", "id": "card_text_color", "label": "Card text", "default": "#3B3B3B" },

    { "type": "header", "content": "Section" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Lets menu links jump here, e.g. #our-values." }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Quality" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We never cut corners. Every formula is backed by research, third-party tested and made to the highest standards, because you deserve nothing less.</p>" },
        {
          "type": "select",
          "id": "art",
          "label": "Artwork",
          "options": [
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "circles", "label": "Circles" },
            { "value": "flower", "label": "Flower" },
            { "value": "none", "label": "None" }
          ],
          "default": "sparkle"
        },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Replaces the artwork and is shown as uploaded, with no extra effects. Square images work best." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF about values",
      "blocks": [
        { "type": "value", "settings": { "title": "Quality", "art": "sparkle" } },
        { "type": "value", "settings": { "title": "Transparency", "art": "circles", "text": "<p>No fluff and no hidden blends. We show you exactly what’s in every sachet and why it’s there, because you have the right to know what you’re putting in your body.</p>" } },
        { "type": "value", "settings": { "title": "Community", "art": "flower", "text": "<p>We exist because women asked for better. Everything we make is shaped by the real experiences of the community we serve, and that will never change.</p>" } }
      ]
    }
  ]
}
{% endschema %}
