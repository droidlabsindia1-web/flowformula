{%- render 'lml-assets', swiper: true -%}

<div class="lml-section lml-ingredients" data-lml-section="ingredients" style="background: {{ section.settings.background }};">
  <div class="lml-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="lml-display-1">{{ section.settings.heading | escape }}</h2>
      <hr class="lml-rule">
    {%- endif -%}
    <div class="swiper lml-ingredients__slider" data-lml-carousel>
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <article class="swiper-slide lml-ing-card" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="lml-rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 1025px) 33vw, 90vw', alt: block.settings.title }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'lml-placeholder' }}
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
      <div class="lml-ingredients__nav">
        <button type="button" class="lml-arrow-btn" data-lml-carousel-prev aria-label="Previous">&larr;</button>
        <div class="lml-ingredients__dots" data-lml-carousel-dots></div>
        <button type="button" class="lml-arrow-btn" data-lml-carousel-next aria-label="Next">&rarr;</button>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LML ingredients",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#dfc8e7" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "what's inside?" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Ingredient name" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Placeholder: one or two lines about this ingredient.</p>" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LML ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "title": "SNZ 1969™ (Bacillus coagulans)" } },
        { "type": "ingredient", "settings": { "title": "Pineapple extract" } },
        { "type": "ingredient", "settings": { "title": "Vitamin C" } }
      ]
    }
  ]
}
{% endschema %}
