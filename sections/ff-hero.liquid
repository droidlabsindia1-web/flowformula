{%- render 'ff-assets' -%}

{%- liquid
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign button_blocks = section.blocks | where: 'type', 'button'
  assign bg = section.settings.background
-%}

<section
  class="hero"
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  aria-labelledby="hero-title-{{ section.id }}"
  {% if bg != blank and bg.alpha != 0.0 %}style="--ff-bg: {{ bg }};"{% endif %}
>
  <div class="hero__inner">
    <h1 class="hero__title" id="hero-title-{{ section.id }}">{{ section.settings.heading | escape }}</h1>

    {%- if stat_blocks.size > 0 -%}
      <ul class="hero__stats">
        {%- for block in stat_blocks -%}
          <li {{ block.shopify_attributes }}>
            <strong>{{ block.settings.value | escape }}</strong>
            <span>{{ block.settings.label | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if button_blocks.size > 0 -%}
      <div class="hero__ctas">
        {%- for block in button_blocks -%}
          <a
            class="btn btn--{{ block.settings.style }} btn--hero"
            href="{{ block.settings.link | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.label | escape -}}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="hero__media">
      {%- render 'dizzy-image',
        image: section.settings.image,
        asset: section.settings.image_asset,
        width: 676,
        height: 856,
        alt: section.settings.image_alt,
        sizes: '(max-width: 767px) 100vw, 34vw',
        widths: '480,676,900,1200',
        priority: true
      -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FF hero",
  "class": "ff",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait, around 676 × 856px. Sits on the right on desktop and behind the heading on mobile." },
    { "type": "text", "id": "image_asset", "label": "Fallback theme asset", "info": "Used until an image is uploaded." },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "header", "content": "Section" },
    { "type": "color", "id": "background", "label": "Background", "info": "Leave empty to use cream on desktop and white on mobile." },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Lets menu links jump here, e.g. #shop." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "peach", "label": "Peach" },
            { "value": "teal", "label": "Teal" }
          ]
        }
      ]
    }
  ],
  "presets": [{ "name": "FF hero" }]
}
{% endschema %}
