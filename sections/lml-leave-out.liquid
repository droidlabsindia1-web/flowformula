{%- render 'lml-assets' -%}

<div class="lml-section lml-leave-out" data-lml-section="leave-out" style="background: {{ section.settings.background }};">
  <div class="lml-container">
    <div class="lml-card lml-leave-out__card">
      <div class="lml-leave-out__copy">
        <h2 class="lml-display-2">
          {{- section.settings.heading | escape | newline_to_br }}
          {%- if section.settings.highlight != blank %} <span class="lml-squiggle">{{ section.settings.highlight | escape }}</span>{%- endif -%}
        </h2>
        {%- if section.settings.text != blank -%}<p class="lml-lead">{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="lml-btn lml-btn--white">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
      <div class="lml-leave-out__list" data-lml-strike>
        <ul>
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LML leave out",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#dfc8e7" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "what we\nleave" },
    { "type": "text", "id": "highlight", "label": "Underlined word", "default": "out", "info": "Shown after the heading with the animated squiggle." },
    { "type": "text", "id": "text", "label": "Text", "default": "Because the label matters as much as the formula" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Left-out item",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Parabens" }]
    }
  ],
  "presets": [
    {
      "name": "LML leave out",
      "blocks": [
        { "type": "item", "settings": { "text": "Parabens" } },
        { "type": "item", "settings": { "text": "Talc" } },
        { "type": "item", "settings": { "text": "Silicon dioxide" } },
        { "type": "item", "settings": { "text": "Synthetic colors" } },
        { "type": "item", "settings": { "text": "Gluten" } },
        { "type": "item", "settings": { "text": "FD&C dyes" } }
      ]
    }
  ]
}
{% endschema %}
