{%- render 'ff-assets' -%}

<section
  class="ingredients"
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  aria-labelledby="ingredients-title-{{ section.id }}"
>
  <h2 class="ingredients__title" id="ingredients-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>

  {%- if section.blocks.size > 0 -%}
    <ul
      class="ingredients__track"
      tabindex="0"
      aria-label="{{ section.settings.heading | escape }}"
      data-ff-ingredients
    >
      {%- assign middle = section.blocks.size | minus: 1 | divided_by: 2 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign crop = block.settings.crop | default: 50
          assign crop_style = 'object-position: 50% ' | append: crop | append: '%;'
        -%}
        <li class="ingredient{% if forloop.index0 == middle %} is-active{% endif %}" {{ block.shopify_attributes }}>
          <article class="ingredient__card">
            {%- render 'dizzy-image',
              image: block.settings.image,
              asset: block.settings.image_asset,
              width: 722,
              height: 502,
              alt: block.settings.alt,
              class: 'ingredient__img',
              style: crop_style,
              sizes: '(max-width: 767px) 319px, (max-width: 1279px) 31vw, 361px',
              widths: '361,540,722,1000'
            -%}
            <div class="ingredient__body">
              <h3 class="ingredient__name">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="ingredient__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </article>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "FF ingredients",
  "class": "ff",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Lets menu links jump here, e.g. #ingredients." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Landscape, around 722 × 502px." },
        { "type": "text", "id": "image_asset", "label": "Fallback theme asset", "info": "Used until an image is uploaded." },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "range", "id": "crop", "label": "Vertical crop position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50, "info": "0% keeps the top of the image, 100% the bottom." },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "FF ingredients" }]
}
{% endschema %}
