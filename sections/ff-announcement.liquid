{%- render 'ff-assets' -%}

{%- liquid
  assign bg = section.settings.background
  assign fg = section.settings.text_color
-%}

{%- if section.settings.text != blank -%}
  <div
    class="announcement"
    style="{% if bg != blank and bg.alpha != 0.0 %}--ff-bg: {{ bg }};{% endif %}{% if fg != blank and fg.alpha != 0.0 %}--ff-fg: {{ fg }};{% endif %}"
  >
    <p>
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
      {%- else -%}
        {{ section.settings.text | escape }}
      {%- endif -%}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "FF announcement",
  "class": "ff",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "info": "Leave empty to use the brand coral." },
    { "type": "color", "id": "text_color", "label": "Text", "info": "Leave empty to use white." }
  ],
  "presets": [{ "name": "FF announcement" }]
}
{% endschema %}
